# ====================================================================
# Skills-to-Job Planner - Backend Environment Configuration Template
# ====================================================================

# Supabase Project Credentials (from your Supabase Dashboard -> Project Settings -> API)
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SECRET_KEY=your-supabase-service-role-secret-key

# Google Gemini API Key (optional but recommended for AI-powered resume insights)
# Get a free key at: https://aistudio.google.com/
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-2.5-flash
